####### Compile

main.o: ../../main.cpp ../../MainWindow2.h \
		../../Candidate.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../main.cpp

Candidate.o: ../../Candidate.cpp ../../Candidate.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Candidate.o ../../Candidate.cpp

MainWindow2.o: ../../MainWindow2.cpp ../../MainWindow2.h \
		../../Candidate.h \
		ui_MainWindow2.h \
		../../CandidateDialog.h \
		../../GlassBoxTest.h \
		../../XlsxWriter.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o MainWindow2.o ../../MainWindow2.cpp

CandidateDialog.o: ../../CandidateDialog.cpp ../../CandidateDialog.h \
		../../Candidate.h \
		ui_CandidateDialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o CandidateDialog.o ../../CandidateDialog.cpp

GlassBoxTest.o: ../../GlassBoxTest.cpp ../../GlassBoxTest.h \
		../../Candidate.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o GlassBoxTest.o ../../GlassBoxTest.cpp

XlsxWriter.o: ../../XlsxWriter.cpp ../../XlsxWriter.h \
		../../GlassBoxTest.h \
		../../Candidate.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o XlsxWriter.o ../../XlsxWriter.cpp

